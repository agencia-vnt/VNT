# Copiar a .env.local para desarrollo. En Vercel se cargan en
# Settings → Environment Variables. .env* está en .gitignore: nunca
# commitear las claves reales.

# URL canónica en producción. Sin barra final.
# En Vercel se puede omitir: se deduce del dominio del proyecto.
NEXT_PUBLIC_SITE_URL=https://vnt.studio

# --- Formulario de contacto (Resend) ---
# Sin esta clave el formulario no envía nada y avisa por consola.
# Crear en https://resend.com → API Keys
RESEND_API_KEY=

# A dónde llegan las consultas. Por defecto usa siteConfig.email.
CONTACT_TO_EMAIL=hola@vnt.studio

# Remitente. Tiene que ser un dominio verificado en Resend.
CONTACT_FROM_EMAIL=web@vnt.studio
