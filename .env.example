# Copiar a .env.local para desarrollo. En Vercel se cargan en
# Settings → Environment Variables. .env* está en .gitignore: nunca
# commitear las claves reales.

# URL canónica en producción. Sin www y sin barra final.
# Definirla explícitamente en Vercel: si se deja deducir del proyecto, puede
# resolver al apex o al *.vercel.app según cómo esté el Primary Domain.
# Se lee en BUILD: cambiarla exige un deploy nuevo para que tome efecto.
NEXT_PUBLIC_SITE_URL=https://vntagencia.com

# --- Formulario de contacto (Resend) ---
# Sin esta clave el formulario devuelve un error y no envía mensajes.
# Crear en https://resend.com → API Keys
RESEND_API_KEY=

# Las consultas llegan a siteConfig.email (vntclub@gmail.com).
# El correo público y el destinatario del formulario tienen una sola fuente.

# Remitente. Tiene que ser un dominio verificado en Resend.
CONTACT_FROM_EMAIL=web@vntagencia.com
